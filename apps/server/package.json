{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "test": "vitest run --passWithNoTests",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@instgarm_feed/db": "workspace:*",
    "@instgarm_feed/env": "workspace:*",
    "@scalar/express-api-reference": "^0.8.24",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "dotenv": "catalog:",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@instgarm_feed/config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "catalog:",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "jsdom": "catalog:",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.1.4",
    "tsdown": "^0.23.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
